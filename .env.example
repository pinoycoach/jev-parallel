# Copy to .env and fill in. .env is git-ignored. Never commit keys.

# Claude writes the hooks and compiles the skill file. Without it, everything runs in MOCK mode.
ANTHROPIC_API_KEY=

# Which model sits behind the gate: jev | claude | mock
# Leave blank to use claude when a key is set, mock otherwise.
GATE=

# Needed when GATE=jev. One Jev call per hook: for the first live run set TOTAL=20.
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
# Jev borderline band: confidence under this goes to the human (0.65 = p between 0.35 and 0.65).
JEV_BORDER=0.65

# Optional
MODEL=claude-haiku-5-5
BORDER=0.75
TOTAL=200
PORT=3000
