# Copy to .env and fill in. .env is git-ignored. Never commit keys.

# Claude writes the hooks and compiles the skill file. Without it, everything runs in MOCK mode.
ANTHROPIC_API_KEY=
# Same key under another name. Use this one in a Claude Code cloud environment, which reserves
# ANTHROPIC_API_KEY for itself and does not pass it to sessions.
APP_CLAUDE_KEY=

# Which model sits behind the gate: jev | claude | mock
# Leave blank to use claude when a key is set, mock otherwise.
GATE=

# Needed when GATE=jev. One Jev call per hook: for the first live run set TOTAL=20.
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
# Set to 1 only where a proxy attaches the Jev key for you (Claude Code cloud environment credential).
JEV_NO_AUTH=
# Jev borderline band: confidence under this goes to the human (0.65 = p between 0.35 and 0.65).
JEV_BORDER=0.65
# Auto-kill: a hook scoring at or above this on "generic AI copy" or "health/guaranteed claim" dies without a human.
JEV_KILL=0.8
# How many of your approved and rejected calls Jev sees per hook (per side).
JEV_EXAMPLES=15

# Optional
MODEL=claude-haiku-5-5
# Optional: a stronger model just for writing the rule file (one call per run and per human call).
SKILL_MODEL=
BORDER=0.75
TOTAL=200
# How many hook-writing calls run at once. Raise it if your Claude account has high rate limits.
GEN_CONCURRENCY=2
PORT=3000
